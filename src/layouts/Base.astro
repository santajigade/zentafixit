---
import '@fontsource-variable/open-sans/wdth.css';
import '@fontsource-variable/open-sans/wdth-italic.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/categories';
import { getPublishedPosts } from '../lib/posts';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  schema?: object[];
  noindex?: boolean;
  progress?: boolean;
  image?: string;
}
const { title, description = SITE.description, type = 'website', schema = [], progress = false, image } = Astro.props;
const ogImage = new URL(image ?? '/images/brand/og-default.jpg', SITE.url).href;
// Review previews (SHOW_DRAFTS=1) must never be indexed.
const noindex = Astro.props.noindex || process.env.SHOW_DRAFTS === '1';
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name} | ${SITE.tagline}` : `${title} | ${SITE.name}`;
const year = new Date().getFullYear();
// Guide counts for the categories menu
const live = await getPublishedPosts();
const countCat = (c: string) => live.filter((p) => p.data.category === c).length;
const countSub = (c: string, sc: string) => live.filter((p) => p.data.category === c && p.data.subcategory === sc).length;
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta property="og:image:width" content="1200" />}
  {ogImage && <meta property="og:image:height" content="630" />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="theme-color" content="#0f2240" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <script is:inline>
    try { const t = localStorage.getItem('zf-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  {SITE.adsenseClient && (
    <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous"></script>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {progress && <div id="progress" aria-hidden="true"></div>}
  <header class="site-header">
    <div class="wrap header-row">
      <a href="/" class="logo" aria-label={`${SITE.name} home`}>
        <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="5" fill="#ffd23f"/><path d="M8 7H24V11.5L14 20.5H24V25H8V20.5L18 11.5H8Z" fill="#0f2240"/></svg>
        <b>Zenta<span>Fixit</span></b>
      </a>
      <nav class="header-nav" aria-label="Main">
        <button class="icon-btn search-btn" type="button" data-open-search aria-label="Search guides">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
          <span class="hide-sm">Search</span> <kbd>/</kbd>
        </button>
        <details class="menu" id="mega">
          <summary>Categories</summary>
          <div class="mega" role="region" aria-label="All categories">
            {CATEGORIES.map((c) => (
              <div class="mega-cat">
                <a class="mega-title" href={`/${c.slug}/`}>{c.name}{countCat(c.slug) > 0 && <span class="count"> ({countCat(c.slug)})</span>}</a>
                <ul>{c.subcategories.map((sc) => <li><a href={`/${c.slug}/${sc.slug}/`}>{sc.name}{countSub(c.slug, sc.slug) > 0 && <span class="count">&nbsp;({countSub(c.slug, sc.slug)})</span>}</a></li>)}</ul>
              </div>
            ))}
          </div>
        </details>
        <a href="/about/" class="hide-sm">About</a>
        <button class="icon-btn" type="button" id="theme-toggle" aria-label="Switch dark or light mode">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <slot name="band" />
  <main id="main" class="wrap"><slot /></main>

  <footer class="site-footer blueprint">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a href="/" class="logo"><svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="5" fill="#ffd23f"/><path d="M8 7H24V11.5L14 20.5H24V25H8V20.5L18 11.5H8Z" fill="#0f2240"/></svg><b>Zenta<span>Fixit</span></b></a>
          <p>Fix-it guides for American homes and the tech inside them. Checked for safety before they go live.</p>
          <ul class="social" aria-label="ZentaFixit on social media">
            <li><a href={SITE.social.instagram} rel="me noopener" target="_blank" aria-label="Instagram"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></a></li>
            <li><a href={SITE.social.facebook} rel="me noopener" target="_blank" aria-label="Facebook"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21z"/></svg></a></li>
            <li><a href={SITE.social.linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M4.5 9h3v11h-3zM6 3.8a1.8 1.8 0 1 1 0 3.6 1.8 1.8 0 0 1 0-3.6zM10 9h2.9v1.5h.1c.4-.8 1.4-1.7 3-1.7 3.2 0 3.8 2.1 3.8 4.8V20h-3v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V20h-3z"/></svg></a></li>
          </ul>
        </div>
        <ul class="footer-cats">{CATEGORIES.map((c) => <li><a href={`/${c.slug}/`}>{c.name}</a></li>)}</ul>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/editorial-policy/">Editorial policy</a></li>
          <li><a href="/privacy-policy/">Privacy policy</a></li>
          <li><a href="/terms/">Terms of use</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
        </ul>
      </div>
      <p class="footer-note">© {year} {SITE.name}. Guides are for information only. When in doubt, hire a licensed professional.</p>
    </div>
  </footer>

  <dialog id="search" aria-label="Search guides">
    <form method="dialog"><input type="search" placeholder="Describe the problem, e.g. breaker keeps tripping" autocomplete="off" data-search-input data-results="dialog-results" /></form>
    <ul class="results" id="dialog-results"></ul>
  </dialog>

  <script>
    // Close the categories menu on outside click or Escape
    const mega = document.getElementById('mega') as HTMLDetailsElement | null;
    document.addEventListener('click', (e) => { if (mega?.open && !mega.contains(e.target as Node)) mega.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && mega?.open) { mega.open = false; mega.querySelector('summary')?.focus(); } });

    // Open on mouse hover (desktop with a mouse); click still works everywhere
    if (mega && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let t: number | undefined;
      mega.addEventListener('mouseenter', () => { clearTimeout(t); if (innerWidth > 700) mega.open = true; });
      mega.addEventListener('mouseleave', () => { t = window.setTimeout(() => { mega.open = false; }, 200); });
      // A mouse click on the button keeps it open (hover already opened it)
      mega.querySelector('summary')?.addEventListener('click', (e) => { if (e.detail > 0 && innerWidth > 700) { e.preventDefault(); mega.open = true; } });
    }

    // Theme toggle
    const root = document.documentElement;
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('zf-theme', next); } catch (e) {}
    });

    // Search: loads a small index on first use, matches every word of the query.
    type Item = { t: string; d: string; u: string; c: string; k: string };
    let index: Item[] | null = null;
    async function load() {
      if (!index) { try { index = await (await fetch('/search.json')).json(); } catch { index = []; } }
      return index!;
    }
    function render(list: HTMLElement, q: string, items: Item[]) {
      const words = q.toLowerCase().split(/\s+/).filter(Boolean);
      if (!words.length) { list.innerHTML = ''; return; }
      const hits = items.filter((i) => words.every((w) => i.k.includes(w))).slice(0, 8);
      list.innerHTML = hits.length
        ? hits.map((h) => `<li><a href="${h.u}"><strong>${h.t}</strong><span>${h.c}</span></a></li>`).join('')
        : `<li class="none">No guide for that yet. Try fewer words, or browse a category.</li>`;
    }
    document.querySelectorAll<HTMLInputElement>('[data-search-input]').forEach((input) => {
      const list = document.getElementById(input.dataset.results!)!;
      input.addEventListener('focus', load, { once: true });
      input.addEventListener('input', async () => render(list, input.value, await load()));
      input.form?.addEventListener('submit', (e) => {
        const first = list.querySelector('a');
        if (first) { e.preventDefault(); location.href = first.getAttribute('href')!; }
      });
    });
    const dlg = document.getElementById('search') as HTMLDialogElement;
    const openSearch = () => { dlg.showModal(); dlg.querySelector('input')?.focus(); };
    document.querySelectorAll('[data-open-search]').forEach((b) => b.addEventListener('click', openSearch));
    document.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement).tagName;
      if (e.key === '/' && tag !== 'INPUT' && tag !== 'TEXTAREA') { e.preventDefault(); openSearch(); }
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

    // Reading progress bar
    const bar = document.getElementById('progress');
    if (bar) {
      const update = () => {
        const h = document.documentElement.scrollHeight - innerHeight;
        bar.style.width = `${h > 0 ? Math.min(100, (scrollY / h) * 100) : 0}%`;
      };
      addEventListener('scroll', update, { passive: true }); update();
    }
  </script>
</body>
</html>
