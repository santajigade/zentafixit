---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES } from '../data/categories';
import { getPublishedPosts } from '../lib/posts';
import { SITE } from '../data/site';

const posts = await getPublishedPosts();
const schema = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url + '/' }];
---
<Base title={SITE.name} schema={schema}>
  <section class="hero">
    <h1>Fix it yourself — the safe, simple way</h1>
    <p>Step-by-step guides for home electrical, smart home, HVAC, appliances, PCs and gadgets. Written in plain English, checked for safety.</p>
  </section>
  {posts.length > 0 && (
    <section>
      <h2>Latest guides</h2>
      <div class="card-grid">{posts.slice(0, 9).map((p) => <PostCard post={p} />)}</div>
    </section>
  )}
  <h2>Browse by category</h2>
  <div class="cat-grid">
    {CATEGORIES.map((c) => <a class="cat-tile" href={`/${c.slug}/`}><strong>{c.name}</strong><span>{c.description}</span></a>)}
  </div>
</Base>
