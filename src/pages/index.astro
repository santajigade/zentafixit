---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES } from '../data/categories';
import { getPublishedPosts, postUrl } from '../lib/posts';
import { SITE, AUTHOR } from '../data/site';

const posts = await getPublishedPosts();
const count = (slug: string) => posts.filter((p) => p.data.category === slug).length;
const schema = [{
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url + '/',
  potentialAction: { '@type': 'SearchAction', target: `${SITE.url}/?q={search_term_string}`, 'query-input': 'required name=search_term_string' },
}];
const quick = posts.slice(0, 6);
---
<Base title={SITE.name} schema={schema}>
  <section slot="band" class="blueprint">
    <div class="wrap hero">
      <svg class="hero-art" viewBox="0 0 320 380" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="60" y="40" width="180" height="300" rx="14"/>
        <rect x="90" y="80" width="120" height="100" rx="10"/><rect x="90" y="200" width="120" height="100" rx="10"/>
        <path d="M128 110v22M172 110v22M128 230v22M172 230v22"/><path d="M142 150a8 8 0 0 1 16 0v8h-16z M142 270a8 8 0 0 1 16 0v8h-16z"/>
        <circle cx="150" cy="190" r="5"/>
        <rect x="104" y="183" width="30" height="14" rx="3" stroke="#ffd23f"/><rect x="166" y="183" width="30" height="14" rx="3" stroke="#ffd23f"/>
        <g stroke-width="1" stroke-dasharray="3 4"><path d="M60 20h180M60 14v12M240 14v12"/><path d="M262 40v300M256 40h12M256 340h12"/></g>
        <g fill="#9fc4f0" stroke="none" font-family="IBM Plex Mono, monospace" font-size="11"><text x="150" y="14" text-anchor="middle">2.75 in</text><text x="270" y="194">4.5 in</text>
        <text x="60" y="366" fill="#ffd23f">TEST</text><text x="208" y="366" fill="#ffd23f">RESET</text></g>
        <path d="M78 356l40-162M226 356l-30-162" stroke="#ffd23f" stroke-width="1" stroke-dasharray="3 4"/>
      </svg>
      <h1>What's broken?</h1>
      <p>Tell us the problem. We'll point you to a step-by-step fix for your home, your gadgets, or the wiring between them, and tell you when to call a pro.</p>
      <form class="hero-search" role="search" action="/" onsubmit="return false">
        <label for="hero-q" class="skip">Describe the problem</label>
        <input id="hero-q" name="q" type="search" placeholder="e.g. GFCI keeps tripping" autocomplete="off" data-search-input data-results="hero-results" />
        <button type="submit">Find a fix</button>
      </form>
      <ul class="results" id="hero-results"></ul>
      {quick.length > 0 && <ul class="quick">{quick.map((p) => <li><a href={postUrl(p)}>{p.data.title.split(/[?:]/)[0]}</a></li>)}</ul>}
    </div>
  </section>

  {posts.length > 0 && (
    <section>
      <div class="section-head"><h2>Latest fixes</h2>{posts.length > 5 && <a href="#categories">All {posts.length} guides by category</a>}</div>
      <ul class="tickets">{posts.slice(0, 5).map((p) => <PostCard post={p} />)}</ul>
    </section>
  )}

  <section>
    <div class="section-head"><h2 id="categories">Browse by part of the house</h2></div>
    <div class="drawers">
      {CATEGORIES.map((c) => (
        <a class="drawer" href={`/${c.slug}/`}>
          <strong>{c.name}</strong>
          <span>{c.description}</span>
          <em>{count(c.slug) ? `${count(c.slug)} guide${count(c.slug) > 1 ? 's' : ''}` : 'Guides coming soon'}</em>
        </a>
      ))}
    </div>
  </section>

  <section class="why" aria-labelledby="why-h">
    <div class="section-head"><h2 id="why-h">Why ZentaFixit</h2></div>
    <div class="why-grid">
      <div class="why-item">
        <svg viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="8" fill="#ffd23f"/><path d="M12 21l6 6 11-13" fill="none" stroke="#0f2240" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h3>Reviewed by an engineer</h3>
        <p>Every guide is checked for technical accuracy and safety by <a href={`/author/${AUTHOR.slug}/`}>{AUTHOR.name}</a>, an Electronics and Telecommunication engineer, before it goes live.</p>
      </div>
      <div class="why-item">
        <svg viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="8" fill="#ffd23f"/><path d="M20 10l11 20H9z" fill="none" stroke="#0f2240" stroke-width="3" stroke-linejoin="round"/><path d="M20 17v6" stroke="#0f2240" stroke-width="3" stroke-linecap="round"/><circle cx="20" cy="26.5" r="1.8" fill="#0f2240"/></svg>
        <h3>Safety first</h3>
        <p>Each guide shows its risk level, tells you when to switch off power, and says clearly when a job needs a licensed pro.</p>
      </div>
      <div class="why-item">
        <svg viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="8" fill="#ffd23f"/><rect x="10" y="10" width="9" height="7" rx="1.5" fill="none" stroke="#0f2240" stroke-width="2.5"/><rect x="21" y="23" width="9" height="7" rx="1.5" fill="none" stroke="#0f2240" stroke-width="2.5"/><path d="M14.5 17v9.5H21" fill="none" stroke="#0f2240" stroke-width="2.5"/></svg>
        <h3>Find the cause fast</h3>
        <p>Start from what you're seeing, follow the diagram, and tick off steps as you go. No guesswork, no wall of text.</p>
      </div>
      <div class="why-item">
        <svg viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="8" fill="#ffd23f"/><circle cx="20" cy="20" r="10" fill="none" stroke="#0f2240" stroke-width="3"/><path d="M15 20.5l3.5 3.5 6.5-7" fill="none" stroke="#0f2240" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <h3>Free and plain English</h3>
        <p>No sign-up, no paywall, no jargon. Written for homeowners and renters, with the technical detail there when you want it.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    // Prefill from ?q= (sitelinks search box)
    const q = new URLSearchParams(location.search).get('q');
    if (q) { const i = document.getElementById('hero-q'); i.value = q; i.dispatchEvent(new Event('focus')); setTimeout(() => i.dispatchEvent(new Event('input')), 50); }
  </script>
</Base>
