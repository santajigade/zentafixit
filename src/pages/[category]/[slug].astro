---
// One route serves both guides (/category/guide-slug/) and subcategory pages (/category/subcategory/).
import PostPage from '../../components/PostPage.astro';
import SubcategoryPage from '../../components/SubcategoryPage.astro';
import { getPublishedPosts, validatePost } from '../../lib/posts';
import { CATEGORIES } from '../../data/categories';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const postPaths = posts.map((post) => {
    validatePost(post);
    return { params: { category: post.data.category, slug: post.id }, props: { kind: 'post', post, all: posts } };
  });
  const subPaths = CATEGORIES.flatMap((cat) =>
    cat.subcategories.map((sub) => ({
      params: { category: cat.slug, slug: sub.slug },
      props: { kind: 'sub', cat, sub, posts: posts.filter((p) => p.data.category === cat.slug && p.data.subcategory === sub.slug) },
    })),
  );
  const seen = new Set(subPaths.map((p) => `${p.params.category}/${p.params.slug}`));
  for (const p of postPaths) if (seen.has(`${p.params.category}/${p.params.slug}`)) throw new Error(`Guide slug "${p.params.slug}" clashes with a subcategory in "${p.params.category}". Rename the guide.`);
  return [...postPaths, ...subPaths];
}
const props = Astro.props as any;
---
{props.kind === 'post' ? <PostPage post={props.post} all={props.all} /> : <SubcategoryPage cat={props.cat} sub={props.sub} posts={props.posts} />}
