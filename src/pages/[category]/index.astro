---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, type Category } from '../../data/categories';
import { getPublishedPosts, type Post } from '../../lib/posts';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return CATEGORIES.map((cat) => ({
    params: { category: cat.slug },
    props: { cat, posts: posts.filter((p) => p.data.category === cat.slug) },
  }));
}
const { cat, posts } = Astro.props as { cat: Category; posts: Post[] };
const groups = cat.subcategories.map((s) => ({ ...s, posts: posts.filter((p) => p.data.subcategory === s.slug) }));
const schema = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
    { '@type': 'ListItem', position: 2, name: cat.name, item: `${SITE.url}/${cat.slug}/` },
  ],
}];
---
<Base title={`${cat.name} Guides`} description={cat.description} schema={schema}>
  <header slot="band" class="band blueprint">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / {cat.name}</nav>
      <h1>{cat.name}</h1>
      <p class="lede">{cat.description}</p>
      <ul class="sub-list">
        {groups.map((g) => <li>{g.posts.length ? <a href={`/${cat.slug}/${g.slug}/`}>{g.name} ({g.posts.length})</a> : <span>{g.name}</span>}</li>)}
      </ul>
    </div>
  </header>
  {posts.length === 0 && <p class="empty">{cat.name} guides are being written and reviewed now. Try <button class="icon-btn" style="color:var(--brand);padding:0" data-open-search>searching</button> for your problem in the meantime.</p>}
  {groups.filter((g) => g.posts.length).map((g) => (
    <section>
      <div class="section-head"><h2 id={g.slug}><a href={`/${cat.slug}/${g.slug}/`} class="h-link">{g.name}</a></h2></div>
      <ul class="tickets">{g.posts.map((p) => <PostCard post={p} showCat={false} />)}</ul>
    </section>
  ))}
</Base>
