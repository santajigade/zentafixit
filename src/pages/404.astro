---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../data/categories';
---
<Base title="Page not found" noindex>
  <div style="height:40px"></div><h1>Page not found</h1>
  <p class="muted">That page doesn't exist or has moved. Try a category below.</p>
  <div class="drawers">{CATEGORIES.map((c) => <a class="drawer" href={`/${c.slug}/`}><strong>{c.name}</strong><span>{c.description}</span></a>)}</div>
</Base>
