---
import { postUrl, formatDate, type Post } from '../lib/posts';
import { getCategory } from '../data/categories';
interface Props { post: Post }
const { post } = Astro.props;
const cat = getCategory(post.data.category);
---
<article class="card">
  <p class="eyebrow"><a href={`/${cat?.slug}/`}>{cat?.name}</a></p>
  <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
  <p class="muted">{post.data.description}</p>
  <p class="small muted">{formatDate(post.data.updatedDate ?? post.data.pubDate)}</p>
</article>
