---
import { postUrl, type Post } from '../lib/posts';
import { getCategory } from '../data/categories';
import Meter from './Meter.astro';
interface Props { post: Post; showCat?: boolean }
const { post, showCat = true } = Astro.props;
const d = post.data;
const cat = getCategory(d.category);
const diff = { easy: 'Easy', moderate: 'Moderate', hard: 'Hard' }[d.difficulty];
---
<li class="ticket">
  <div class="ticket-cat">{showCat ? <a href={`/${cat?.slug}/`}>{cat?.name}</a> : cat?.subcategories.find((s) => s.slug === d.subcategory)?.name}</div>
  <div>
    <h3><a href={postUrl(post)}>{d.title}</a></h3>
    <p>{d.description}</p>
  </div>
  <div class="ticket-spec">
    <span class="badge" title="Difficulty"><Meter level={d.difficulty} />{diff}</span>
    <span class="badge" title="Time needed">{d.time}</span>
    {d.risk !== 'low' && <span class={`badge risk-${d.risk}`}>{d.risk === 'danger' ? 'Shock risk' : 'Use caution'}</span>}
  </div>
</li>
